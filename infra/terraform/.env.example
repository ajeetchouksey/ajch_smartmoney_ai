# ── SmartMoney AI — Terraform Environment Variables ──────────────────────────
# Copy this file to .env, fill in your values, then source it before running
# Terraform:
#
#   cp .env.example .env
#   source .env          # Linux/macOS
#   . .env               # PowerShell: Get-Content .env | ForEach-Object { ... }
#
# Variables prefixed with TF_VAR_ are automatically picked up by Terraform.
# ARM_ variables authenticate the azurerm provider.

# ── Azure Auth ────────────────────────────────────────────────────────────────
# Use `az login` (interactive) OR service principal credentials below.
# Service principal (CI/CD):
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_SECRET=<your-client-secret>

# ── Remote State (optional) ───────────────────────────────────────────────────
# Required if you uncomment the backend block in main.tf
# TF_BACKEND_RG=rg-tfstate
# TF_BACKEND_SA=stsmartmoneytfstate
# TF_BACKEND_CONTAINER=tfstate

# ── Terraform Variables ───────────────────────────────────────────────────────
# These override defaults in variables.tf or the selected .tfvars file.

# TF_VAR_environment=dev
# TF_VAR_location=eastus
# TF_VAR_location_short=eus

# ── Container Images ──────────────────────────────────────────────────────────
# Set these once you have built and pushed images to ACR.
# TF_VAR_api_image=<acr-name>.azurecr.io/smartmoney-api:latest
# TF_VAR_worker_image=<acr-name>.azurecr.io/smartmoney-worker:latest

# ── Azure AI Foundry ──────────────────────────────────────────────────────────
# Found in: AI Foundry portal → your project → Overview
TF_VAR_foundry_endpoint=https://YOUR-PROJECT.services.ai.azure.com
TF_VAR_foundry_model=gpt-4o-mini
TF_VAR_foundry_api_version=2024-08-01-preview
# API Key — AI Foundry portal → your project → Keys and Endpoints
TF_VAR_foundry_api_key=<your-foundry-api-key>
